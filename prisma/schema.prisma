generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                  Int         @id @default(autoincrement())
  name                String
  email               String      @unique
  password            String
  role                UserRole
  departmentId        Int?
  isActive            Boolean     @default(true)
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt
  department          Department? @relation(fields: [departmentId], references: [id])
  
  employeeTickets     Ticket[]    @relation("EmployeeTickets")
  agentTickets        Ticket[]    @relation("AgentTickets")
  messages            Message[]
  notifications       Notification[]  @relation("NotificationRecipient")
  actorNotifications  Notification[]  @relation("NotificationActor")

  @@index([role, departmentId])
}



model Department {
  id            Int         @id @default(autoincrement())
  name          String

  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  
  users         User[]
  categories    Category[]
  tickets       Ticket[]
}



model Category {
  id                Int         @id @default(autoincrement())
  name              String
  description       String?
  isActive          Boolean     @default(true)
  departmentId      Int

  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  department        Department  @relation(fields: [departmentId], references: [id], onDelete: Restrict)

  tickets           Ticket[]

  @@unique([departmentId, name])
}




model Ticket {
  id                Int             @id @default(autoincrement())
  number            String          @unique
  title             String
  description       String
  status            StatusTicket    @default(OPEN)
  priority          PriorityTicket

  departmentId      Int
  categoryId        Int
  employeeId        Int
  agentId           Int?

  department        Department      @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  category          Category        @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  employee          User            @relation("EmployeeTickets", fields: [employeeId], references: [id], onDelete: Restrict)
  agent             User?           @relation("AgentTickets", fields: [agentId], references: [id], onDelete: SetNull)

  assignedAt        DateTime?
  resolvedAt        DateTime?
  closedAt          DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  messages          Message[]
  notifications     Notification[]
  
  
  @@index([employeeId])
  @@index([agentId])
  @@index([departmentId])
  @@index([categoryId])
}





model Message {
  id                Int             @id @default(autoincrement())
  content           String

  senderId          Int
  ticketId          Int

  sender            User            @relation(fields: [senderId], references: [id], onDelete: Restrict)
  ticket            Ticket          @relation(fields: [ticketId], references: [id], onDelete: Restrict)

  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([senderId])
  @@index([ticketId])
}




model Notification {
  id                Int               @id @default(autoincrement())
  targetId          Int
  actorId           Int?
  ticketId          Int?
  type              NotificationType
  title             String
  message           String
  isRead            Boolean           @default(false)

  target            User              @relation("NotificationRecipient", fields: [targetId], references: [id], onDelete: Cascade)
  actor             User?             @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)
  ticket            Ticket?           @relation(fields: [ticketId], references: [id], onDelete: SetNull)

  createdAt         DateTime          @default(now())
  
  @@index([targetId, isRead])
  @@index([ticketId])
  @@index([createdAt])
}



enum UserRole {
  ADMIN
  AGENT
  EMPLOYEE
}



enum StatusTicket {
  OPEN
  IN_PROGRESS
  WAITING
  RESOLVED
  RE_PROGRESS
  CLOSED
  CANCELLED
}


enum PriorityTicket {
  LOW
  MEDIUM
  HIGH
  URGENT
}



enum NotificationType {
  TICKET_CREATED
  TICKET_TAKEN
  TICKET_WAITING
  TICKET_IN_PROGRESS
  TICKET_RESOLVED
  TICKET_REOPENED
  TICKET_CLOSED
  TICKET_CANCELLED
  MESSAGE_RECEIVED
}